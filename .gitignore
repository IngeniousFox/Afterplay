# Secretos de desarrollo del Worker. Wrangler los lee de aquí para `wrangler
# dev`; en producción los mismos nombres viven en los secrets de Cloudflare,
# así que este fichero nunca sale de tu máquina.
.dev.vars
.dev.vars.*
.wrangler
