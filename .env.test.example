# Credenciales de los tests E2E — copia este fichero a .env.test y rellena.
#
# .env.test es la UNICA fuente de credenciales de los tests de extremo a
# extremo (ver e2e/credentials.ts). Nada mas se lee: ni el .env del proyecto,
# ni el credentials.json real, ni lo que lleve puesto la terminal. Esa lista
# blanca es lo que hace seguro tener credenciales de verdad aqui.
#
# .env.test NO se commitea (esta en .gitignore). Este .example si, para que
# se sepa que hace falta sin tener que adivinarlo.
#
# TODO ES OPCIONAL: sin este fichero la suite corre igual, y cada test que
# necesite una clave concreta se salta solo diciendo cual le falta. Rellena
# solo las integraciones que quieras vigilar.

# ── IGDB, via Twitch (dev.twitch.tv) ──────────────────────────────────────
# Desbloquea: la busqueda del alta, notas, sinopsis y fechas.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── SteamGridDB (steamgriddb.com/profile/preferences/api) ─────────────────
# Desbloquea: caratulas y heroes.
STEAMGRIDDB_API_KEY=

# ── Steam Web API (steamcommunity.com/dev/apikey) ─────────────────────────
# Desbloquea: catalogos de logros. Las etiquetas y resenas de la tienda NO
# necesitan clave, asi que esos tests corren siempre.
STEAM_API_KEY=
STEAM_USER_ID64=

# ── RetroAchievements (retroachievements.org/settings) ────────────────────
RA_USERNAME=
RA_API_KEY=

# ── Anthropic (console.anthropic.com) ─────────────────────────────────────
# Desbloquea: curiosidades y recaps. Ojo: estas SI cuestan dinero por llamada.
ANTHROPIC_API_KEY=

# ── Turso: LA BASE DE TEST, JAMAS LA DE PRODUCCION ────────────────────────
#
# Leelo antes de rellenar esto:
#
#  1. Por defecto NO se usan. Un test tiene que pedir sync explicitamente
#     (createSandbox({ withRemote: true })), y ademas el andamio enciende una
#     segunda bandera. Dos cerraduras para la unica puerta que escribe fuera
#     del sandbox.
#  2. Cuando se usan, el sandbox EMPUJA sus juegos de mentira a esa remota y
#     se trae los de ella. O sea: la base que pongas aqui se ensucia con
#     "Hollow Knight E2E" y compania, y los tests dejan de ver solo lo que
#     sembraron. Pon una base DESECHABLE, no la que usas a mano para probar.
#  3. Si por lo que sea acaba aqui la URL de produccion, el punto 2 se lo hace
#     a tu biblioteca de verdad. Comprueba el host antes de guardar.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Cloudflare R2 (partidas guardadas) ────────────────────────────────────
# Sin rellenar a proposito en la plantilla: R2 guarda partidas REALES y no hay
# ningun test que necesite escribir alli. Si algun dia lo hay, que sea contra
# un bucket desechable.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
