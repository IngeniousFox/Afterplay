{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  // El contrato de la API (../src/shared/api/v2) se importa solo como tipos y
  // llega por los propios imports de src/api.ts: no hace falta listarlo.
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
