{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Los tipos de Workers vienen de hub/worker/node_modules (su package.json).
    // `node` es solo para los tests, que usan node:test y node:sqlite.
    "types": ["@cloudflare/workers-types", "node"],
    "typeRoots": ["../../node_modules/@types", "./node_modules"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
