{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Los tipos de Workers se toman del paquete que ya instala worker/ (la 1.x
    // desaparece en la fase 10; entonces este tsconfig apuntará al suyo).
    // `node` es solo para los tests, que usan node:test y node:sqlite.
    "types": ["../../worker/node_modules/@cloudflare/workers-types", "node"],
    "typeRoots": ["../../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
