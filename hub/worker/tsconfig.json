{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Los tipos de Workers vienen del paquete que instala hub/worker/package.json.
    // `node` es solo para los tests, que usan node:test y node:sqlite.
    "types": ["./node_modules/@cloudflare/workers-types", "node"],
    "typeRoots": ["../../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
