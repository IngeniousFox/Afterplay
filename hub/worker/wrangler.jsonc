{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Hub de Afterplay 2.0 (§9). La configuración de arriba es la de PRODUCCIÓN
  // (`afterplay-hub`) y NO se despliega hasta la puesta en marcha. Lo que hay
  // desplegado es el hub de DESARROLLO, siempre con `--env dev` (ver abajo).
  // Este Worker NUNCA debe llamarse `afterplay-web`: ese es el Worker de
  // producción de la 1.x (rama main), que sigue sirviendo hasta la fase 10. Un
  // `wrangler deploy` con el nombre equivocado machacaría el de producción.
  "name": "afterplay-hub",
  "main": "src/index.ts",
  // Contrato de ejecución fijado, el mismo que usó el Worker de la 1.x.
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],

  // Sin "routes" ni dominios propios: de momento solo *.workers.dev. Las
  // rutas /sync/v1/* NO van tras Access (los clientes no son navegadores,
  // §9.2); /api/v2/* sí, y esa aplicación de Access se crea al desplegar.
  "workers_dev": true,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [
      // Uno por persona (§9.1). Se direcciona con idFromName(<inquilino>).
      { "name": "TENANT_HUB", "class_name": "TenantHubObject" },
      // Uno para todo el despliegue: inquilinos, invitaciones, correo -> inquilino.
      { "name": "DIRECTORY", "class_name": "DirectoryObject" },
    ],
  },
  // SQLite en ambos (plan gratuito: solo se admiten clases con SQLite).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantHubObject", "DirectoryObject"] }],

  // Variables (ninguna con valor aquí: este fichero se commitea, y el repo es
  // público). Todas van como secrets del despliegue (`wrangler secret put`):
  //  · ADMIN_EMAIL        correo del anfitrión; su primera entrada crea su
  //                       inquilino (§9.3). Sin él no hay anfitrión.
  //  · ACCESS_TEAM_DOMAIN dominio del equipo de Access (xxx.cloudflareaccess.com).
  //  · ACCESS_AUD         AUD de la aplicación de Access que protege /api/v2/*.
  //  · HUB_ADMIN_TOKEN    opcional: segunda puerta de /api/v2/* para el
  //                       anfitrión, mientras no haya PWA (src/adminToken.ts).
  //  · HUB_SECRETS_KEY    clave (32+ caracteres al azar) que cifra las claves de IGDB
  //                       que sube cada PC (src/credentialBundle.ts). Sin ella
  //                       el hub rechaza esas claves y la PWA no busca juegos.
  // En local, en hub/worker/.dev.vars (que no se commitea), donde además pueden
  // ir ENVIRONMENT=development y DEV_EMAIL para saltarse Access SOLO en local.
  // Sin ACCESS_* ni HUB_ADMIN_TOKEN, /api/v2/* falla cerrado (401).

  // La PWA (fase 5, §13) se sirve desde ESTE MISMO Worker como assets estáticos,
  // igual que hacía la 1.x: un solo origen (cero CORS, una sola aplicación de
  // Access) y los assets no cuentan para la cuota de peticiones de Workers.
  // Se construye antes con `npm run build` en web/.
  //
  // `run_worker_first` en /api/* y /sync/* es lo que hace que el fallback de SPA
  // no se trague las rutas del hub devolviendo index.html con un 200: esas dos
  // siempre pasan por el código del Worker; todo lo demás lo sirven los assets
  // sin invocarlo, y las rutas desconocidas caen a index.html (la PWA enruta).
  // El entorno `dev` lo hereda (wrangler hereda `assets`).
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sync/*"],
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "env": {
    // Hub de DESARROLLO: `wrangler deploy --env dev`. Su nombre empieza por
    // `afterplay-dev`, que es lo único que acepta el perfil de desarrollo de
    // la app (src/main/lib/devProfileRules.ts). Sus Durable Objects son
    // propios: no comparte datos con ningún otro despliegue. Sin Access: su
    // /api/v2/* solo abre con HUB_ADMIN_TOKEN (scripts/hub-dev.ts).
    "dev": {
      "name": "afterplay-dev-hub",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "TENANT_HUB", "class_name": "TenantHubObject" },
          { "name": "DIRECTORY", "class_name": "DirectoryObject" },
        ],
      },
    },
  },
}
