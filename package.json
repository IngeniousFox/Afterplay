{
  "name": "Afterplay",
  "version": "1.7.3",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache src web/src hub e2e scripts *.config.ts eslint.config.mjs web/vite.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:pwa": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:hub": "tsc --noEmit -p hub/core/tsconfig.json && tsc --noEmit -p hub/worker/tsconfig.json && tsc --noEmit -p hub/convergence/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:pwa && npm run typecheck:e2e && npm run typecheck:hub",
    "pretest": "tsx scripts/clean-test-temp.ts",
    "test": "tsx --test --experimental-test-module-mocks \"src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"hub/**/*.test.ts\"",
    "posttest": "tsx scripts/clean-test-temp.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "benchmark:journey": "tsx scripts/benchmark-journey.ts",
    "benchmark:shared": "tsx scripts/benchmark-shared.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:v2": "tsx scripts/dev-profile.ts v2",
    "dev:v2:seed": "tsx scripts/seed-dev-profile.ts v2",
    "hub:dev": "tsx scripts/hub-dev.ts",
    "dev:pwa:hub": "npm --prefix web run dev:hub",
    "hub:dev:smoke": "tsx scripts/hub-dev-smoke.ts",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron",
    "ludusavi:fetch": "tsx scripts/fetch-ludusavi.ts",
    "build:unpack": "npm run ludusavi:fetch && npm run build && electron-builder --dir",
    "build:win": "npm run ludusavi:fetch && npm run build && electron-builder --win",
    "release:win": "tsx scripts/release.ts",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "db:v2:generate": "drizzle-kit generate --config drizzle.v2.config.ts",
    "db:v2:import": "tsx scripts/import-1x-to-v2.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/lib-storage": "3.1171.0",
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@kmamal/sdl": "^0.11.13",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "axios": "^1.21.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.4",
    "electron-updater": "^6.8.11",
    "find-process": "^2.1.1",
    "lucide-react": "^1.74.0",
    "ps-list": "^9.0.0",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "steamgriddb": "^2.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tursodatabase/sync": "0.7.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^44.11.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
