{
  "name": "Afterplay",
  "version": "1.7.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache src web/src worker/src e2e scripts *.config.ts eslint.config.mjs web/vite.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "typecheck:pwa": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:worker && npm run typecheck:pwa && npm run typecheck:e2e",
    "pretest": "tsx scripts/clean-test-temp.ts",
    "test": "tsx --test --experimental-test-module-mocks \"src/**/*.test.ts\" \"worker/src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "posttest": "tsx scripts/clean-test-temp.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "benchmark:journey": "tsx scripts/benchmark-journey.ts",
    "benchmark:shared": "tsx scripts/benchmark-shared.ts",
    "benchmark:db": "tsx --test --experimental-test-module-mocks scripts/benchmark-db.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron",
    "ludusavi:fetch": "tsx scripts/fetch-ludusavi.ts",
    "build:unpack": "npm run ludusavi:fetch && npm run build && electron-builder --dir",
    "build:win": "npm run ludusavi:fetch && npm run build && electron-builder --win",
    "release:win": "tsx scripts/release.ts",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "db:push:remote": "tsx scripts/push-migrations-to-turso.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@kmamal/sdl": "^0.11.13",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tursodatabase/sync": "0.7.2",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.3",
    "drizzle-orm": "1.0.0-rc.4",
    "electron-updater": "^6.8.9",
    "find-process": "^2.1.1",
    "lucide-react": "^1.48.0",
    "ps-list": "^9.0.0",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "steamgriddb": "^2.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.3.6"
  }
}
